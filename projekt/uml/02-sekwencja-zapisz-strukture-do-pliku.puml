@startuml
title Sekwencja: Zapisz strukturę do pliku (serializacja drzewa do JSON)

actor "Użytkownik" as U
participant "Interfejs\n(obsługa)" as UI
participant ":SystemPlikow" as SP
participant ":SystemPlikowZapis" as ZP
participant "WezelDane" as WD
participant "wezel :WezelSystemuPlikow" as W
participant "Gson\n(biblioteka)" as G
participant "Files\n(java.nio)" as F

U -> UI : zapisz strukturę
activate UI
UI -> SP : zapiszDoPliku()
activate SP
SP -> SP : wymagajZalogowanego()
SP -> ZP : zapisz(korzen)
activate ZP

ZP -> WD : zWezla(korzen)
activate WD
loop dla każdego węzła w drzewie (rekurencja po dzieciach)
  WD -> W : getNazwa(), getWlasciciel(), getPrawa(), getDzieci() / odczytaj()
  activate W
  W --> WD : dane węzła
  deactivate W
  note right of WD
    Właściciel zapisywany jako login (String),
    nie jako cały obiekt — bez duplikacji
    użytkowników w pliku.
  end note
end
WD --> ZP : korzenDane
deactivate WD

ZP -> G : toJson(korzenDane)
activate G
G --> ZP : json
deactivate G
ZP -> F : writeString(plik, json)
activate F
alt błąd zapisu (IOException)
  F --> ZP : IOException
  ZP --> SP : BladOperacjiException("nie udało się zapisać")
  SP --> UI : BladOperacjiException
  UI --> U : "Nie udało się zapisać struktury"
else zapis się udał
  F --> ZP : (ok)
  deactivate F
  ZP --> SP : (ok)
  deactivate ZP
  SP --> UI : (ok)
  UI --> U : "Zapisano strukturę"
end
deactivate SP
deactivate UI

@enduml
