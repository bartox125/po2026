@startuml
title Symulator Systemu Plików — diagram przypadków użycia
left to right direction
skinparam packageStyle rectangle

actor "Użytkownik" as U
actor "Administrator" as A
A --|> U

rectangle "Symulator Systemu Plików" {

  package "Struktura drzewa" {
    usecase "Utwórz plik" as UC_NowyPlik
    usecase "Utwórz katalog" as UC_NowyKatalog
    usecase "Usuń element" as UC_Usun
    usecase "Usuń katalog\nwraz z zawartością" as UC_UsunRek
    usecase "Przenieś element" as UC_Przenies
    usecase "Zmień nazwę elementu" as UC_Nazwa
    usecase "Wyświetl zawartość\nkatalogu" as UC_Lista
    usecase "Przejdź do katalogu" as UC_CD
    usecase "Odczytaj / zapisz\nzawartość pliku" as UC_Tresc
  }

  package "Prawa dostępu" {
    usecase "Sprawdź prawa dostępu" as UC_Sprawdz
    usecase "Zgłoś brak uprawnień" as UC_Odmowa
    usecase "Zmień prawa dostępu" as UC_Chmod
    usecase "Zmień właściciela" as UC_Chown
  }

  package "Konta i uwierzytelnianie" {
    usecase "Zaloguj się" as UC_Login
    usecase "Wyloguj się" as UC_Logout
    usecase "Odrzuć logowanie" as UC_Odrzuc
    usecase "Utwórz konto\nużytkownika" as UC_NowyUzytkownik
    usecase "Zmień hasło\nużytkownika" as UC_Haslo
  }

  package "Serializacja" {
    usecase "Zapisz strukturę\ndo pliku" as UC_Zapisz
    usecase "Wczytaj strukturę\nz pliku" as UC_Wczytaj
  }
}

' --- aktorzy ---
U --> UC_NowyPlik
U --> UC_NowyKatalog
U --> UC_Usun
U --> UC_Przenies
U --> UC_Nazwa
U --> UC_Lista
U --> UC_CD
U --> UC_Tresc
U --> UC_Chmod
U --> UC_Zapisz
U --> UC_Wczytaj
U --> UC_Login
U --> UC_Logout
A --> UC_Chown
A --> UC_NowyUzytkownik
A --> UC_Haslo

' --- include: zawsze wymagane ---
UC_NowyPlik ..> UC_Sprawdz : <<include>>
UC_NowyKatalog ..> UC_Sprawdz : <<include>>
UC_Usun ..> UC_Sprawdz : <<include>>
UC_Przenies ..> UC_Sprawdz : <<include>>
UC_Nazwa ..> UC_Sprawdz : <<include>>
UC_Lista ..> UC_Sprawdz : <<include>>
UC_CD ..> UC_Sprawdz : <<include>>
UC_Tresc ..> UC_Sprawdz : <<include>>
UC_Chmod ..> UC_Sprawdz : <<include>>
UC_Chown ..> UC_Sprawdz : <<include>>
UC_NowyUzytkownik ..> UC_Sprawdz : <<include>>
UC_Haslo ..> UC_Sprawdz : <<include>>

' --- extend: tylko w pewnych warunkach ---
UC_Odrzuc ..> UC_Login : <<extend>>
note on link
  warunek: niepoprawny login lub hasło
end note
UC_UsunRek ..> UC_Usun : <<extend>>
note on link
  warunek: usuwany element to niepusty katalog
end note
UC_Odmowa ..> UC_Sprawdz : <<extend>>
note on link
  warunek: brak wymaganego uprawnienia
end note

note as N_warunki
  Warunek wstępny wszystkich przypadków użycia
  poza „Zaloguj się”: użytkownik jest zalogowany.
  Operacje na kontach (utwórz konto, zmień hasło)
  oraz zmiana właściciela są dostępne tylko dla
  Administratora (sprawdza je „Sprawdź prawa dostępu”).
  Pierwsze konto administratora powstaje przy
  inicjalizacji systemu, gdy nie ma jeszcze żadnych kont.
end note
U .. N_warunki

@enduml
